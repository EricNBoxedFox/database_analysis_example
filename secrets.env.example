# AI Config
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=YOUR_LOADED_MODEL_ID(Reccomended QWEN3)
SQ_LITE_1_CREDENTIALS=first-sq-lite-db-credentials

# SMTP config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

SMTP_AUTH=true
SMTP_USE_SSL=false
SMTP_START_TLS=true

# PGP
PGP_ENABLED=true
PGP_SIGN_ENABLED=true
PGP_ENCRYPT_ENABLED=true

# Use example keys for testing (unencrypted, no password)
PGP_PRIVATE_KEY_PATH=encryption_keys/example_sender_secret.asc
PGP_PUBLIC_KEY_PATH=encryption_keys/example_sender_public.asc
PGP_PRIVATE_KEY_PASSWORD=
PGP_RECIPIENT_KEYS=encryption_keys/example_recipient_public.asc

# ============================================================
# EMAIL NOTIFICATIONS
# ============================================================

EMAIL_TO=admin@example.com
EMAIL_CC=
EMAIL_BCC=manager@example.com

EMAIL_SUBJECT=Ecommerce Pipeline Notification
EMAIL_ENCRYPTED_SUBJECT=Encrypted Notification